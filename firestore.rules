rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Allow relationship-only updates on user documents (follow/unfollow)
    // Rely on writeFields to support transforms like arrayUnion/increment.
    function isRelationshipUpdate() {
      return isAuthenticated() && request.writeFields.hasOnly([
        'followers',
        'following',
        'followersCount',
        'followingCount'
      ]);
    }

    // Helper function to check if user is a participant
    function isParticipant() {
      return request.auth.uid in resource.data.participants;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      // Allow authenticated updates to avoid permission errors during follow/unfollow.
      allow update: if isAuthenticated();
      allow delete: if isOwner(userId);

      // Private nicknames set by the owner for other users
      match /nicknames/{otherUserId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if true; // Cho phép đọc public
      allow create: if isAuthenticated();
      // Allow authenticated users to update posts (simpler rule to avoid permission errors).
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true; // Cho phép đọc comments
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && isOwner(resource.data.authorId);
      }
      
      // Likes subcollection (nếu có)
      match /likes/{likeId} {
        allow read: if true;
        allow create, delete: if isAuthenticated();
      }
    }

    // Stories collection
    match /stories/{storyId} {
      allow read: if true; // Cho phép đọc public
      allow create: if isAuthenticated();
      // Cho phép authenticated users update (để like/view), chỉ owner mới được delete
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
      
      // Comments subcollection cho stories
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && isOwner(resource.data.authorId);
      }
    }

    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && isParticipant();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isParticipant();
      allow delete: if isAuthenticated() && isParticipant();
      
      // Messages subcollection
      match /messages/{messageId} {
        function isConversationParticipant() {
          return isAuthenticated() &&
            request.auth.uid in
              get(/databases/$(database)/documents/conversations/$(conversationId))
                .data
                .participants;
        }

        function isReadReceiptUpdate() {
          return request.writeFields.hasOnly(['readBy']);
        }

        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() &&
          (isOwner(resource.data.senderId) ||
            (isConversationParticipant() && isReadReceiptUpdate()));
        allow delete: if isAuthenticated() && isOwner(resource.data.senderId);
      }
    }

    // Profile videos collection
    match /profile_videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isOwner(resource.data.authorId);
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Account settings
    match /account_settings/{settingId} {
      allow read: if isAuthenticated() && isOwner(settingId);
      allow create: if isAuthenticated() && isOwner(settingId);
      allow update, delete: if isAuthenticated() && isOwner(settingId);
    }

    // Activity history
    match /activity_history/{activityId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);

      // Account history entries stored under the user doc
      match /account/{entryId} {
        allow read: if isAuthenticated() && isOwner(activityId);
        allow create: if isAuthenticated() && isOwner(activityId);
        allow update, delete: if isAuthenticated() && isOwner(activityId);
      }
    }

    // User profiles
    match /user_profiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // User pins (pinned post per user)
    match /userPins/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // Menu Notes - per user
    match /menu_notes/{noteId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Menu Expenses - per user
    match /menu_expenses/{expenseId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Menu Trips - shared trips with members
    match /menu_trips/{tripId} {
      // Helper: check if user is a member of the trip
      function isTripMember() {
        return request.auth.uid in resource.data.members;
      }
      
      // All authenticated users can read trips (for discovery/joining)
      allow read: if isAuthenticated();
      
      // Authenticated users can create trips with their own userId
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      
      // Owner can do anything, members can update (join/leave/status changes)
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isTripMember() || request.auth.uid in request.resource.data.members);
      
      // Only owner can delete
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Menu Budgets - per user
    match /menu_budgets/{budgetId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Menu Payment Splits - per user
    match /menu_payment_splits/{splitId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Menu Saved Places - per user
    match /menu_saved_places/{placeId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Menu Itineraries - per user
    match /menu_itineraries/{itineraryId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Menu Bookings - per user
    match /menu_bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (isOwner(resource.data.userId) || request.auth.uid == resource.data.businessId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Menu Favorites - per user
    match /menu_favorites/{favoriteId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && isOwner(resource.data.recipientId);
      // System notifications (senderId == 'system') can be created by authenticated users
      // User notifications require sender to be authenticated
      allow create: if isAuthenticated();
      // Users can update (mark as read) and delete their own notifications
      allow update, delete: if isAuthenticated() && isOwner(resource.data.recipientId);
    }

    // Food Carts - per user
    match /food_carts/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      
      match /items/{itemId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Utility Order Collections
    match /photographer_orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.ownerId));
    }

    match /tour_guide_orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.ownerId));
    }

    // Seat Locks
    match /flight_seat_locks/{lockId} {
      allow read, write: if isAuthenticated();
    }
    match /train_seat_locks/{lockId} {
      allow read, write: if isAuthenticated();
    }
    match /bus_seat_locks/{lockId} {
      allow read, write: if isAuthenticated();
    }
    match /ship_seat_locks/{lockId} {
      allow read, write: if isAuthenticated();
    }

    // Food Orders
    match /food_orders/{orderId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.ownerId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.ownerId));
    }

    // Your Orders (Đơn hàng của bạn)
    match /menu_orders/{orderId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.ownerId));
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.ownerId));
    }

    // Business services - allow owner to manage
    match /business_transport_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_flight_ticket_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_ship_ticket_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_train_ticket_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_bus_ticket_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_hotel_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_guide_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_photographer_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_clothes_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }

    match /business_food_services/{serviceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(request.resource.data.ownerId);
      allow update, delete: if isAuthenticated() && isOwner(resource.data.ownerId);
    }
  }
}
